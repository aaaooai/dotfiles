Host archiso
    User root
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

Host archlinux
    User arch
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null

Host alarm
    User alarm
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    
AddKeysToAgent yes
ForwardAgent yes
ServerAliveInterval 60
SendEnv TMUX
Compression yes
AddressFamily inet
IdentitiesOnly yes
Include *_config

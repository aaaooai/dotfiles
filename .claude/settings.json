{
  "model": "haiku",
  "enabledPlugins": {
    "genshijin@genshijin": true
  },
  "extraKnownMarketplaces": {
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      }
    }
  },
  "theme": "light",
  "statusLine": {
    "type": "command",
    "command": "sh /home/tt/.claude/statusline-command.sh"
  },
  "attribution": {
    "commit": ""
  },
  "sandbox": {
    "enabled": false,
    "filesystem": {
      "denyRead": [
        "/root/.ssh",
        "/home/*/.ssh",
        "/home/*/.aws",
        "/home/*/.kube",
        "/home/*/.docker",
        "/home/*/.gnupg",
        "/etc/shadow",
        "/etc/sudoers"
      ]
    },
    "network": {
      "allowLocalBinding": false,
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh /home/tt/.claude/hooks/pre-submit.sh",
            "statusMessage": "Scanning for secrets..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh /home/tt/.claude/hooks/pre-submit.sh && sh /home/tt/.claude/hooks/sandbox.sh",
            "statusMessage": "Security check: command & file access..."
          }
        ]
      }
    ]
  }
}
